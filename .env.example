# LunchShift environment. Copy to .env and fill in only what you have:
#   cp .env.example .env
# Every service is optional. A blank value means "not set": that service uses its labelled
# fallback (shown as "fallback" or "missing" on /console), and the safety rules never depend on it.
# Names only here; never commit real values.

# Anthropic Claude: turns the parent's chat into facts and explains swaps. Blank: rule-based chat parser and template text.
ANTHROPIC_API_KEY=

# Cognee Cloud: household memory. Both needed. Blank: facts come from the household record.
COGNEE_API_KEY=
COGNEE_BASE_URL=

# Statsig: autonomy_mode dynamic config (the autonomy ceiling) and agent analytics. Blank: suggest_only.
STATSIG_SERVER_SECRET=

# Superlinked SIE: allergen classifier and reranker. Blank: rules alone decide; local vector ranking.
SIE_API_KEY=

# SingleStore: system of record and vector SQL. Either one connection URL or host/user/password/database.
# Blank: a local SQLite stand-in under .data/.
SINGLESTORE_URL=
SINGLESTORE_HOST=
SINGLESTORE_USER=
SINGLESTORE_PASSWORD=
SINGLESTORE_DATABASE=

# Stripe test mode only: an sk_test_ key turns on "Pay (test card)" for the parent. A live key is refused.
# Blank: pay at pickup only.
STRIPE_SECRET_KEY=

# Optional settings. Leave them commented out to use the defaults shown.
# LUNCHSHIFT_CATALOG=off              # real Open Food Facts products (the public demo uses this); default: small fixture catalog
# LUNCHSHIFT_DB_NAME=lunchshift       # SingleStore database name to create and use
# LLM_PROVIDER=anthropic              # anthropic | template
# LLM_MODEL=                          # Claude model id; default set in src/lib/llm
# SIE_BASE_URL=https://api.superlinked.com
# PUBLIC_URL=http://localhost:3000    # HTTPS origin for Stripe Checkout return links when deployed
# GROCER_PORT=4100                    # sandbox store port
# GROCER_URL=http://127.0.0.1:4100    # where the worker and web app reach the sandbox store
# GROCER_AGENT_TOKEN=                 # sandbox store tokens; defaults are fine locally
# GROCER_OPERATOR_TOKEN=
# WORKER_SCHEDULE_AT=now              # make the Sunday run due as soon as the worker starts
# LUNCHSHIFT_PAID_DAILY_CAP=400       # public-demo cap on paid endpoints per day
